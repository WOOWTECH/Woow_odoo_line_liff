<?xml version="1.0" encoding="utf-8"?>
<!-- woow_odoo_line_liff/views/liff_bind_confirm.xml -->
<!-- LINE email 對應到既有聯絡人時的確認信與確認頁（見 models/line_user.py 的
     _request_bind_confirmation）。頁面不套 web.frontend_layout：LIFF 路由是 auth='none'。 -->
<odoo>

    <template id="liff_bind_page_frame" name="LIFF bind page frame">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width,initial-scale=1"/>
                <meta name="robots" content="noindex"/>
                <title t-out="title"/>
                <style>
                    body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#F5F5F5;font-family:'Noto Sans TC',sans-serif;color:#333}
                    .card{background:#fff;border-radius:12px;padding:28px 24px;max-width:360px;margin:16px;box-shadow:0 1px 4px rgba(0,0,0,.08);text-align:center}
                    h1{font-size:18px;margin:0 0 12px}
                    p{font-size:14px;line-height:1.6;color:#555;margin:8px 0}
                    button{margin-top:16px;width:100%;padding:12px;border:0;border-radius:8px;background:#06C755;color:#fff;font-size:15px}
                </style>
            </head>
            <body>
                <div class="card">
                    <t t-out="0"/>
                </div>
            </body>
        </html>
    </template>

    <template id="liff_bind_email_sent" name="LIFF bind: confirmation sent">
        <t t-call="woow_odoo_line_liff.liff_bind_page_frame">
            <t t-set="title">請到信箱確認</t>
            <h1>請到信箱確認綁定</h1>
            <p>這個 LINE 帳號的 email 對應到既有的會員資料。為了保護帳號安全，我們寄了一封確認信到
                <strong t-out="email_hint"/>。</p>
            <p>請在 <t t-out="ttl_minutes"/> 分鐘內點信中的連結並按下確認，完成後回到 LINE 重新開啟即可。</p>
            <p>沒有收到信，或這不是你的信箱，請聯絡店家協助綁定。</p>
        </t>
    </template>

    <template id="liff_bind_contact_store" name="LIFF bind: contact the store">
        <t t-call="woow_odoo_line_liff.liff_bind_page_frame">
            <t t-set="title">請聯絡店家</t>
            <h1>請聯絡店家協助綁定</h1>
            <p>這個 LINE 帳號的 email 對應到既有的帳號資料，目前無法自動完成綁定。</p>
            <p>請直接傳訊息給我們，由專人協助處理。</p>
        </t>
    </template>

    <template id="liff_bind_confirm_page" name="LIFF bind: confirm">
        <t t-call="woow_odoo_line_liff.liff_bind_page_frame">
            <t t-set="title">確認綁定 LINE 帳號</t>
            <h1>確認綁定 LINE 帳號</h1>
            <p>LINE 使用者「<strong t-out="line_name"/>」要求綁定到 <strong t-out="partner_name"/> 的會員資料。</p>
            <p>綁定後，這個 LINE 帳號就能查看此會員的訂單、預約與通知。若不是你本人操作，請直接關閉此頁。</p>
            <form method="post" action="/liff/bind/confirm">
                <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                <input type="hidden" name="token" t-att-value="token"/>
                <button type="submit">確認綁定</button>
            </form>
        </t>
    </template>

    <template id="liff_bind_result" name="LIFF bind: result">
        <t t-call="woow_odoo_line_liff.liff_bind_page_frame">
            <t t-if="ok">
                <t t-set="title">綁定完成</t>
                <h1>綁定完成</h1>
                <p>請回到 LINE 重新開啟選單，就會以這份會員資料登入。</p>
            </t>
            <t t-else="">
                <t t-set="title">連結無效</t>
                <h1>連結無效或已過期</h1>
                <p>請回到 LINE 重新開啟選單，系統會再寄一封新的確認信。</p>
            </t>
        </t>
    </template>

    <template id="liff_bind_confirm_email" name="LIFF bind: confirmation email">
        <div style="font-family:'Noto Sans TC',sans-serif;font-size:14px;line-height:1.6;color:#333">
            <p><t t-out="partner_name"/> 您好：</p>
            <p>LINE 使用者「<t t-out="line_name"/>」要求把 LINE 帳號綁定到您的會員資料。
                若是您本人操作，請在 <t t-out="ttl_minutes"/> 分鐘內點下面的連結，並在開啟的頁面按「確認綁定」。</p>
            <p><a t-att-href="confirm_url">確認綁定 LINE 帳號</a></p>
            <p>若不是您本人操作，請忽略這封信，您的資料不會有任何變動。</p>
        </div>
    </template>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_home_assigned_tasks" name="My assigned project tasks"
              inherit_id="portal.portal_my_home" priority="45">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="line_assigned_task_ids"
               t-value="request.env.user._line_portal_assigned_task_ids()"/>
            <t t-if="line_assigned_task_ids"
               t-set="portal_service_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_service_category" position="inside">
            <t t-if="line_assigned_task_ids" t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/project/static/src/img/tasks.svg'"/>
                <t t-set="title">我的專案任務</t>
                <t t-set="url" t-value="'/my/assigned-tasks'"/>
                <t t-set="text">查看指派給我的專案任務與進度</t>
                <t t-set="count" t-value="len(line_assigned_task_ids)"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </div>
    </template>

    <template id="portal_assigned_task_breadcrumbs" name="My assigned task breadcrumbs"
              inherit_id="portal.portal_breadcrumbs" priority="35">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'line_assigned_tasks'" class="breadcrumb-item active">我的專案任務</li>
            <t t-if="page_name == 'line_assigned_task'">
                <li class="breadcrumb-item"><a href="/my/assigned-tasks">我的專案任務</a></li>
                <li class="breadcrumb-item active text-truncate" t-out="task.name"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_assigned_tasks" name="My assigned project tasks">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <h1 class="h3 mb-3">我的專案任務</h1>
            <p class="text-muted">這裡顯示指派給您同一聯絡人內部帳號的任務，僅供查看。</p>
            <div t-if="not tasks" class="alert alert-info" role="status">目前沒有指派給您的專案任務。</div>
            <div t-else="" class="row g-3">
                <div class="col-12" t-foreach="tasks" t-as="task">
                    <a t-att-href="'/my/assigned-tasks/%s' % task.id"
                       class="card text-decoration-none text-body">
                        <div class="card-body">
                            <h2 class="h5 mb-1" t-out="task.name"/>
                            <div class="text-muted small">
                                <span t-field="task.project_id"/>
                                <span t-if="task.stage_id"> · <span t-field="task.stage_id"/></span>
                                <span t-if="task.date_deadline"> · 期限 <span t-field="task.date_deadline"/></span>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
            <t t-call="portal.pager"/>
        </t>
    </template>

    <template id="portal_my_assigned_task" name="My assigned project task">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <div class="card mt-3">
                <div class="card-body">
                    <h1 class="h3" t-out="task.name"/>
                    <dl class="row mb-0">
                        <dt class="col-sm-3">專案</dt><dd class="col-sm-9"><span t-field="task.project_id"/></dd>
                        <dt class="col-sm-3">階段</dt><dd class="col-sm-9"><span t-field="task.stage_id"/></dd>
                        <dt class="col-sm-3">狀態</dt><dd class="col-sm-9"><span t-field="task.state"/></dd>
                        <t t-if="task.date_deadline">
                            <dt class="col-sm-3">期限</dt><dd class="col-sm-9"><span t-field="task.date_deadline"/></dd>
                        </t>
                    </dl>
                    <div t-if="description" class="border-top pt-3 mt-3" style="white-space: pre-wrap" t-out="description"/>
                </div>
            </div>
            <a href="/my/assigned-tasks" class="btn btn-link px-0 mt-3">返回我的專案任務</a>
        </t>
    </template>
</odoo>
